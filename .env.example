# REQUIRED in production (>= 32 characters each). The backend will refuse to
# start if the JWT signing secret or INTERNAL_CALL_SECRET is missing.
JWT_SECRET_KEY=xxxxxx
INTERNAL_CALL_SECRET=xxxxxx
GLOBAL_SECRETS_ENCRYPTION_KEY=xxxxxx

# OPTIONAL
WORKER_MAX_CONCURRENCY=1
WORKER_REGISTRATION_SECRET=xxxxxx
ADMIN_INITIAL_PASSWORD=
VAULT_SERVER_SECRET=
CORS_ALLOWED_ORIGINS=https://opensible.example.com

# Scheduling System
AUTOSYNC_CHECK_INTERVAL=120
PLAYBOOK_SCHEDULER_INTERVAL=300
EXECUTION_RECOVERY_INTERVAL=600
HOST_STATUS_SCHEDULER_INTERVAL=600