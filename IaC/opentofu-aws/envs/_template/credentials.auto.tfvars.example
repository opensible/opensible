# Copy to credentials.auto.tfvars (chmod 600) and paste your AWS credentials.
# Create in IAM Console → Users → Security credentials → Access keys.
# Required minimal permissions for this stack: AmazonEC2FullAccess (or a
# narrower policy covering EC2/VPC/SG/KeyPair/IGW/RT actions).
aws_access_key = "REPLACE_ME_AWS_ACCESS_KEY_ID"
aws_secret_key = "REPLACE_ME_AWS_SECRET_ACCESS_KEY"
