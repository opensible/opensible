# Copy to credentials.auto.tfvars (chmod 600) and paste your ByteDC credentials.
# The OpenSible worker materialises this file automatically from the wizard's
# encrypted secrets on every run.
access_key     = "REPLACE_ME_BYTEDC_ACCESS_KEY"
secret_key     = "REPLACE_ME_BYTEDC_SECRET_KEY"
ecs_admin_pass = "REPLACE_ME_STRONG_PASSWORD"
