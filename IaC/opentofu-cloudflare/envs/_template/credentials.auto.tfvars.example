# Copy to credentials.auto.tfvars (chmod 600) and paste your Cloudflare API token.
# The token is created in Cloudflare Dashboard → My Profile → API Tokens.
# Required scopes depend on what you provision:
#   - DNS records:     Zone.DNS:Edit, Zone.Zone:Read (Edit if create_zone)
#   - R2 buckets:      Account.Workers R2 Storage:Edit
#   - Workers:         Account.Workers Scripts:Edit, Zone.Workers Routes:Edit
#   - Access apps:     Zone.Access: Apps and Policies:Edit
api_token = "REPLACE_ME_CLOUDFLARE_API_TOKEN"
