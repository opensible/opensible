# Copy to credentials.auto.tfvars (chmod 600) and paste your GCP service
# account JSON key. Create in IAM & Admin → Service Accounts → Keys.
# OpenSible runs as the service account in this JSON key, not as your Cloud
# Shell user. Grant the roles below to the JSON key's client_email.
# Required roles for this stack:
#   - Kubernetes Engine Admin  (roles/container.admin)
#   - Compute Network Admin    (roles/compute.networkAdmin)
#   - Service Account Admin    (roles/iam.serviceAccountAdmin) when
#     manage_node_service_account_act_as_binding = true
#   - Service Account User     (roles/iam.serviceAccountUser) on the node
#     service account. If node_service_account_email is empty, that means the
#     JSON key's client_email must be granted actAs on itself.
gcp_credentials_json = <<EOT
{
  "type": "service_account",
  "project_id": "REPLACE_ME",
  "private_key_id": "REPLACE_ME",
  "private_key": "REPLACE_ME",
  "client_email": "REPLACE_ME",
  "client_id": "REPLACE_ME",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
EOT
