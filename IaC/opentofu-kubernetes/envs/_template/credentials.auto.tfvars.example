# For auth_method="kubeconfig", OpenSible writes the kubeconfig YAML to
# ./kubeconfig.yaml (chmod 600) at execution time — no tfvars needed.
#
# For auth_method="token", copy this file to credentials.auto.tfvars and fill:
# cluster_ca_cert = "BASE64_ENCODED_CA_CERT"
# cluster_token   = "BEARER_TOKEN"
